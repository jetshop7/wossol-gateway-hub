# Wossol Export-owned PostgreSQL connection. Never use the wossol-platform
# DATABASE_URL here and never commit real credentials.
WOSSOL_EXPORT_DATABASE_URL=postgresql://user:password@localhost:5432/wossol_export_catalog

# Explicit, one-shot local/operator bootstrap only. Never commit real values.
# WOSSOL_EXPORT_BOOTSTRAP_CONFIRM=CREATE
# WOSSOL_EXPORT_BOOTSTRAP_EMAIL=admin@example.com
# WOSSOL_EXPORT_BOOTSTRAP_PASSWORD=use-a-secret-password-of-at-least-12-characters
# WOSSOL_EXPORT_BOOTSTRAP_DISPLAY_NAME=Catalog Administrator
