generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Wossol Export owns this database boundary. Do not use the platform
  // repository's DATABASE_URL or connect this schema to its database.
  url      = env("WOSSOL_EXPORT_DATABASE_URL")
}

enum CatalogRecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CatalogPublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ProductExtractionReviewState {
  UNDER_REVIEW
  REQUIRES_CORRECTION
  ACCEPTED
  PUBLISHED
}

enum ProductExtractionVerificationState {
  UNVERIFIED
  PARTIALLY_VERIFIED
  VERIFIED
}

enum ProductExtractionEvidenceConfidence {
  CONFIRMED
  CORROBORATED
  PROPOSED
  UNKNOWN
}

enum ProductExtractionSourceKind {
  COMPANY
  PRODUCT
  IMAGE
  DOCUMENT
}

enum ProductExtractionAssetKind {
  IMAGE
  DOCUMENT
}

enum ProductExtractionRightsStatus {
  UNKNOWN
  CLEARED
  RESTRICTED
}

enum CatalogTaxonomySource {
  GS1_GPC
  WOSSOL_EXTENSION
}

enum CatalogTaxonomyLevel {
  SEGMENT
  FAMILY
  CLASS
  BRICK
}

enum CatalogTaxonomyReleaseStatus {
  IMPORTING
  ACTIVE
  SUPERSEDED
  FAILED
}

enum CatalogTaxonomyTranslationSource {
  GS1_GPC
  WOSSOL_MANAGED
}

enum VariantPricingMethod {
  MARKUP_PERCENT
  FIXED_SELLING_PRICE
}

enum PipelineCompanyLinkageStatus {
  PROPOSED
  LINKED
  REJECTED
  UNLINKED
}

enum InternalUserStatus {
  ACTIVE
  DISABLED
}

enum InternalCatalogRole {
  CATALOG_ADMIN
  CATALOG_EDITOR
}

enum ClientAccountStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum ClientAccountType {
  DIRECT_CLIENT
  PARTNER
}

enum PriceProfileStatus {
  ACTIVE
  INACTIVE
}

enum VariantPriceOverrideMode {
  FIXED_CLIENT_PRICE
  PERCENTAGE_ADJUSTMENT
}

enum ClientCatalogAccessStatus {
  ENABLED
  DISABLED
}

enum ClientCatalogAccessMode {
  ALL_APPROVED
  SELECTED
}

enum ClientCatalogVisibilityEffect {
  INCLUDE
  EXCLUDE
}

enum ClientCatalogVisibilityTarget {
  TAXONOMY
  COMPANY
  PRODUCT
}

enum ClientUserStatus {
  ACTIVE
  DISABLED
}

enum ClientUserDesignation {
  PRIMARY_ADMIN
  CLIENT_USER
}

enum AuthActorType {
  INTERNAL
  CLIENT
  PARTNER
}

// G1-B search foundation: these models mirror the operational Pipeline's
// SQLite tables without importing data or coupling search records to catalog
// Company rows. Source timestamps and evidence snapshots remain String because
// the source system stores them as TEXT and may contain legacy values.
model PipelineCompany {
  companyId                   String  @id @map("company_id")
  legalName                   String? @map("legal_name")
  tradeName                   String? @map("trade_name")
  countryCode                 String? @map("country_code")
  countryRaw                  String? @map("country_raw")
  normalizedDomain            String? @map("normalized_domain")
  normalizedEmail             String? @map("normalized_email")
  normalizedPhone             String? @map("normalized_phone")
  normalizedName              String? @map("normalized_name")
  normalizedLocation          String? @map("normalized_location")
  sector                      String?
  wilaya                      String?
  city                        String?
  address                     String?
  website                     String?
  phone                       String?
  whatsapp                    String?
  contactPerson               String? @map("contact_person")
  department                  String?
  email                       String?
  discoverySource             String? @map("discovery_source")
  sourceUrl                   String? @map("source_url")
  discoveryDate               String? @map("discovery_date")
  qualificationStatus         String  @default("UNKNOWN") @map("qualification_status")
  duplicateStatus             String  @default("NOT_CHECKED") @map("duplicate_status")
  duplicateReason             String? @map("duplicate_reason")
  duplicateMatchCompanyIds    String? @map("duplicate_match_company_ids")
  lifecycleStatus             String  @default("DISCOVERED") @map("lifecycle_status")
  currentAction               String  @default("REVIEW_COMPANY") @map("current_action")
  firstOutreachAt             String? @map("first_outreach_at")
  lastContactAt               String? @map("last_contact_at")
  nextFollowUpAt              String? @map("next_follow_up_at")
  replyStatus                 String  @default("NO_REPLY") @map("reply_status")
  commercialProgress          String  @default("NOT_CONTACTED") @map("commercial_progress")
  catalogReceived             Int     @default(0) @map("catalog_received")
  pricesReceived              Int     @default(0) @map("prices_received")
  requiredInformationReceived Int     @default(0) @map("required_information_received")
  exportExperienceStatus      String  @default("UNKNOWN") @map("export_experience_status")
  exportExperienceEvidence    String? @map("export_experience_evidence")
  exportExperienceSourceUrl   String? @map("export_experience_source_url")
  exportExperienceNote        String? @map("export_experience_note")
  exportExperienceUpdatedAt   String? @map("export_experience_updated_at")
  internalNotes               String? @map("internal_notes")
  createdAt                   String  @map("created_at")
  updatedAt                   String  @map("updated_at")

  contacts          PipelineContact[]
  communications    PipelineCommunication[]
  actions           PipelineAction[]
  auditEvents       PipelineCompanyAuditEvent[]
  contactPoints     PipelineContactPoint[]
  outreachDrafts    PipelineOutreachDraft[]
  sendPlans         PipelineSendPlan[]
  sendAttempts      PipelineSendAttempt[]
  discoveryEvents   PipelineDiscoveryEvent[]
  companyCategories PipelineCompanyCategory[]
  classifications   PipelineCompanyClassification[]

  @@index([lifecycleStatus], map: "pipeline_idx_companies_lifecycle")
  @@index([currentAction], map: "pipeline_idx_companies_action")
  @@map("pipeline_companies")
}

model PipelineContact {
  contactId  String  @id @map("contact_id")
  companyId  String  @map("company_id")
  name       String?
  department String?
  email      String?
  phone      String?
  whatsapp   String?
  isPrimary  Int     @default(0) @map("is_primary")
  createdAt  String  @map("created_at")

  company PipelineCompany @relation(fields: [companyId], references: [companyId], onDelete: Restrict)

  @@map("pipeline_contacts")
}

model PipelineCommunication {
  communicationId      String  @id @map("communication_id")
  companyId            String  @map("company_id")
  eventType            String  @map("event_type")
  direction            String?
  channel              String?
  occurredAt           String  @map("occurred_at")
  sender               String?
  recipients           String?
  subject              String?
  body                 String?
  status               String?
  externalMessageId    String? @map("external_message_id")
  contactPointId       String? @map("contact_point_id")
  contactValueSnapshot String? @map("contact_value_snapshot")
  outcome              String?
  operatorSummary      String? @map("operator_summary")
  commercialResult     String? @map("commercial_result")
  nextAction           String? @map("next_action")
  nextFollowUpAt       String? @map("next_follow_up_at")
  commercialFlags      String? @map("commercial_flags")
  createdAt            String  @map("created_at")

  company PipelineCompany @relation(fields: [companyId], references: [companyId], onDelete: Restrict)

  @@index([companyId, occurredAt], map: "pipeline_idx_communications_company")
  @@map("pipeline_communications")
}

model PipelineAction {
  actionId    String  @id @map("action_id")
  companyId   String  @map("company_id")
  actionType  String  @map("action_type")
  status      String  @default("OPEN")
  dueAt       String? @map("due_at")
  notes       String?
  createdAt   String  @map("created_at")
  completedAt String? @map("completed_at")

  company PipelineCompany @relation(fields: [companyId], references: [companyId], onDelete: Restrict)

  @@map("pipeline_actions")
}

model PipelineCompanyAuditEvent {
  auditId   String  @id @map("audit_id")
  companyId String  @map("company_id")
  eventType String  @map("event_type")
  details   String
  reason    String?
  createdAt String  @map("created_at")

  company PipelineCompany @relation(fields: [companyId], references: [companyId], onDelete: Restrict)

  @@index([companyId, createdAt], map: "pipeline_idx_company_audit_company")
  @@map("pipeline_company_audit_events")
}

model PipelineContactPoint {
  contactPointId     String  @id @map("contact_point_id")
  companyId          String  @map("company_id")
  contactType        String  @map("contact_type")
  normalizedValue    String  @map("normalized_value")
  displayValue       String  @map("display_value")
  businessFunction   String? @map("business_function")
  whatsappStatus     String  @default("UNKNOWN") @map("whatsapp_status")
  verificationStatus String  @default("UNVERIFIED") @map("verification_status")
  provenance         String?
  sourceUrl          String? @map("source_url")
  firstDiscoveredAt  String  @map("first_discovered_at")
  updatedAt          String  @map("updated_at")
  active             Int     @default(1)
  operatorNote       String? @map("operator_note")

  company        PipelineCompany              @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  sources        PipelineContactPointSource[]
  planRecipients PipelineSendPlanRecipient[]
  sendAttempts   PipelineSendAttempt[]

  @@unique([companyId, contactType, normalizedValue], map: "pipeline_contact_points_company_type_value_key")
  @@index([companyId, active, contactType], map: "pipeline_idx_contact_points_company")
  @@map("pipeline_contact_points")
}

model PipelineContactPointSource {
  contactPointSourceId String  @id @map("contact_point_source_id")
  contactPointId       String  @map("contact_point_id")
  provenance           String?
  sourceUrl            String? @map("source_url")
  evidence             String?
  createdAt            String  @map("created_at")

  contactPoint PipelineContactPoint @relation(fields: [contactPointId], references: [contactPointId], onDelete: Restrict)

  @@unique([contactPointId, provenance, sourceUrl, evidence], map: "pipeline_contact_point_sources_identity_key")
  @@map("pipeline_contact_point_sources")
}

model PipelineOutreachDraft {
  draftId        String  @id @map("draft_id")
  companyId      String  @map("company_id")
  currentVersion Int     @map("current_version")
  status         String
  createdAt      String  @map("created_at")
  updatedAt      String  @map("updated_at")
  approvedAt     String? @map("approved_at")
  approvedBy     String? @map("approved_by")

  company      PipelineCompany                @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  versions     PipelineOutreachDraftVersion[]
  sendPlans    PipelineSendPlan[]
  sendAttempts PipelineSendAttempt[]

  @@index([companyId, updatedAt], map: "pipeline_idx_outreach_drafts_company")
  @@map("pipeline_outreach_drafts")
}

model PipelineOutreachDraftVersion {
  versionId         String  @id @map("version_id")
  draftId           String  @map("draft_id")
  versionNumber     Int     @map("version_number")
  channel           String
  externalLanguage  String  @map("external_language")
  subject           String?
  externalMessage   String  @map("external_message")
  arabicTranslation String? @map("arabic_translation")
  translationStatus String  @map("translation_status")
  draftStatus       String  @map("draft_status")
  contextMetadata   String? @map("context_metadata")
  createdAt         String  @map("created_at")
  updatedAt         String  @map("updated_at")
  approvedAt        String? @map("approved_at")
  approvalMetadata  String? @map("approval_metadata")

  draft        PipelineOutreachDraft @relation(fields: [draftId], references: [draftId], onDelete: Restrict)
  sendPlans    PipelineSendPlan[]
  sendAttempts PipelineSendAttempt[]

  @@unique([draftId, versionNumber], map: "pipeline_outreach_draft_versions_draft_version_key")
  @@map("pipeline_outreach_draft_versions")
}

model PipelineSendPlan {
  sendPlanId         String  @id @map("send_plan_id")
  companyId          String  @map("company_id")
  draftId            String  @map("draft_id")
  versionId          String  @map("version_id")
  channel            String
  authorizationState String  @map("authorization_state")
  sendState          String  @default("NOT_STARTED") @map("send_state")
  createdAt          String  @map("created_at")
  updatedAt          String  @map("updated_at")
  authorizedAt       String? @map("authorized_at")
  operatorMetadata   String? @map("operator_metadata")

  company    PipelineCompany              @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  draft      PipelineOutreachDraft        @relation(fields: [draftId], references: [draftId], onDelete: Restrict)
  version    PipelineOutreachDraftVersion @relation(fields: [versionId], references: [versionId], onDelete: Restrict)
  recipients PipelineSendPlanRecipient[]
  attempts   PipelineSendAttempt[]

  @@index([companyId, createdAt], map: "pipeline_idx_send_plans_company")
  @@map("pipeline_send_plans")
}

model PipelineSendPlanRecipient {
  sendPlanRecipientId String  @id @map("send_plan_recipient_id")
  sendPlanId          String  @map("send_plan_id")
  contactPointId      String  @map("contact_point_id")
  normalizedValue     String  @map("normalized_value")
  displayValue        String  @map("display_value")
  outcome             String?
  createdAt           String  @map("created_at")

  sendPlan     PipelineSendPlan     @relation(fields: [sendPlanId], references: [sendPlanId], onDelete: Restrict)
  contactPoint PipelineContactPoint @relation(fields: [contactPointId], references: [contactPointId], onDelete: Restrict)

  @@unique([sendPlanId, contactPointId], map: "pipeline_send_plan_recipients_plan_contact_key")
  @@map("pipeline_send_plan_recipients")
}

model PipelineSendAttempt {
  sendAttemptId     String  @id @map("send_attempt_id")
  sendPlanId        String  @map("send_plan_id")
  companyId         String  @map("company_id")
  draftId           String  @map("draft_id")
  versionId         String  @map("version_id")
  contactPointId    String  @map("contact_point_id")
  sender            String
  recipient         String
  subject           String?
  externalMessage   String  @map("external_message")
  attemptAt         String  @map("attempt_at")
  provider          String
  status            String
  providerMessageId String? @map("provider_message_id")
  errorClass        String? @map("error_class")
  errorMessage      String? @map("error_message")
  successfulAt      String? @map("successful_at")
  createdAt         String  @map("created_at")

  sendPlan     PipelineSendPlan             @relation(fields: [sendPlanId], references: [sendPlanId], onDelete: Restrict)
  company      PipelineCompany              @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  draft        PipelineOutreachDraft        @relation(fields: [draftId], references: [draftId], onDelete: Restrict)
  version      PipelineOutreachDraftVersion @relation(fields: [versionId], references: [versionId], onDelete: Restrict)
  contactPoint PipelineContactPoint         @relation(fields: [contactPointId], references: [contactPointId], onDelete: Restrict)

  @@index([sendPlanId, contactPointId, attemptAt], map: "pipeline_idx_send_attempts_plan")
  @@map("pipeline_send_attempts")
}

model PipelineDiscoveryEvent {
  eventId           String  @id @map("event_id")
  companyId         String? @map("company_id")
  candidateId       String? @map("candidate_id")
  discoverySource   String? @map("discovery_source")
  sourceUrl         String? @map("source_url")
  discoveredAt      String  @map("discovered_at")
  rawSnapshot       String  @map("raw_snapshot")
  outcome           String
  duplicateStatus   String  @map("duplicate_status")
  matchReasons      String? @map("match_reasons")
  matchEvidence     String? @map("match_evidence")
  matchedCompanyIds String? @map("matched_company_ids")
  fingerprint       String  @unique
  createdAt         String  @map("created_at")

  company   PipelineCompany?            @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  candidate PipelineDiscoveryCandidate? @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)

  @@index([companyId, discoveredAt], map: "pipeline_idx_discovery_events_company")
  @@map("pipeline_discovery_events")
}

model PipelineDiscoveryCandidate {
  candidateId         String  @id @map("candidate_id")
  legalName           String? @map("legal_name")
  tradeName           String? @map("trade_name")
  countryCode         String? @map("country_code")
  countryRaw          String? @map("country_raw")
  city                String?
  wilaya              String?
  address             String?
  website             String?
  sector              String?
  activityEvidence    String? @map("activity_evidence")
  discoverySource     String? @map("discovery_source")
  sourceUrl           String? @map("source_url")
  discoveryDate       String  @map("discovery_date")
  qualificationStatus String  @default("PENDING_REVIEW") @map("qualification_status")
  duplicateStatus     String  @default("NOT_CHECKED") @map("duplicate_status")
  duplicateReason     String? @map("duplicate_reason")
  matchEvidence       String  @default("{}") @map("match_evidence")
  matchedCompanyIds   String  @default("[]") @map("matched_company_ids")
  matchedCandidateIds String  @default("[]") @map("matched_candidate_ids")
  rejectionReason     String? @map("rejection_reason")
  lifecycleState      String  @default("DISCOVERED") @map("lifecycle_state")
  possibleCompanyId   String? @map("possible_company_id")
  promotedCompanyId   String? @map("promoted_company_id")
  rawSnapshot         String  @map("raw_snapshot")
  normalizedDomain    String? @map("normalized_domain")
  normalizedEmail     String? @map("normalized_email")
  normalizedPhone     String? @map("normalized_phone")
  normalizedName      String? @map("normalized_name")
  normalizedLocation  String? @map("normalized_location")
  fingerprint         String  @unique
  createdAt           String  @map("created_at")
  updatedAt           String  @map("updated_at")

  contacts        PipelineDiscoveryCandidateContact[]
  categories      PipelineDiscoveryCandidateCategory[]
  events          PipelineDiscoveryCandidateEvent[]
  discoveryEvents PipelineDiscoveryEvent[]

  @@index([lifecycleState, updatedAt], map: "pipeline_idx_discovery_candidates_state")
  @@map("pipeline_discovery_candidates")
}

model PipelineDiscoveryCandidateContact {
  candidateContactId String  @id @map("candidate_contact_id")
  candidateId        String  @map("candidate_id")
  contactType        String  @map("contact_type")
  normalizedValue    String  @map("normalized_value")
  displayValue       String  @map("display_value")
  businessFunction   String? @map("business_function")
  verificationStatus String  @default("UNVERIFIED") @map("verification_status")
  provenance         String?
  sourceUrl          String? @map("source_url")
  evidence           String?
  createdAt          String  @map("created_at")

  candidate PipelineDiscoveryCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)

  @@unique([candidateId, contactType, normalizedValue], map: "pipeline_discovery_candidate_contacts_identity_key")
  @@index([contactType, normalizedValue], map: "pipeline_idx_discovery_candidate_contacts_value")
  @@map("pipeline_discovery_candidate_contacts")
}

model PipelineDiscoveryCandidateCategory {
  candidateId      String  @map("candidate_id")
  categoryCode     String  @map("category_code")
  assignedAt       String  @map("assigned_at")
  assignmentSource String? @map("assignment_source")

  candidate PipelineDiscoveryCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  category  PipelineCategory           @relation(fields: [categoryCode], references: [categoryCode], onDelete: Restrict)

  @@id([candidateId, categoryCode])
  @@index([categoryCode, candidateId], map: "pipeline_idx_discovery_candidate_categories_category")
  @@map("pipeline_discovery_candidate_categories")
}

model PipelineDiscoveryCandidateEvent {
  eventId     String @id @map("event_id")
  candidateId String @map("candidate_id")
  eventType   String @map("event_type")
  details     String
  createdAt   String @map("created_at")

  candidate PipelineDiscoveryCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)

  @@map("pipeline_discovery_candidate_events")
}

model PipelineCategory {
  categoryCode       String  @id @map("category_code")
  displayName        String  @map("display_name")
  parentCategoryCode String? @map("parent_category_code")
  active             Int     @default(1)
  provenance         String?
  creationReason     String? @map("creation_reason")
  createdAt          String  @map("created_at")

  parent              PipelineCategory?                    @relation("PipelineCategoryParent", fields: [parentCategoryCode], references: [categoryCode], onDelete: Restrict)
  children            PipelineCategory[]                   @relation("PipelineCategoryParent")
  candidateCategories PipelineDiscoveryCandidateCategory[]
  companyCategories   PipelineCompanyCategory[]
  classifications     PipelineCompanyClassification[]

  @@map("pipeline_categories")
}

model PipelineCountry {
  countryCode String @id @map("country_code")
  displayName String @map("display_name")
  aliases     String @default("[]")
  active      Int    @default(1)
  createdAt   String @map("created_at")

  @@map("pipeline_countries")
}

model PipelineCompanyCategory {
  companyId        String  @map("company_id")
  categoryCode     String  @map("category_code")
  assignedAt       String  @map("assigned_at")
  assignmentSource String? @map("assignment_source")

  company  PipelineCompany  @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  category PipelineCategory @relation(fields: [categoryCode], references: [categoryCode], onDelete: Restrict)

  @@id([companyId, categoryCode])
  @@index([categoryCode, companyId], map: "pipeline_idx_company_categories_category")
  @@map("pipeline_company_categories")
}

model PipelineCompanyClassification {
  classificationId     String  @id @map("classification_id")
  companyId            String  @map("company_id")
  categoryCode         String  @map("category_code")
  classificationStatus String  @map("classification_status")
  provenance           String?
  sourceUrl            String? @map("source_url")
  evidence             String?
  note                 String?
  classifiedAt         String  @map("classified_at")
  createdAt            String  @map("created_at")
  updatedAt            String  @map("updated_at")

  company  PipelineCompany  @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  category PipelineCategory @relation(fields: [categoryCode], references: [categoryCode], onDelete: Restrict)

  @@unique([companyId, categoryCode], map: "pipeline_company_classifications_company_category_key")
  @@index([categoryCode, classificationStatus, companyId], map: "pipeline_idx_company_classifications_category")
  @@map("pipeline_company_classifications")
}

model PipelineDiscoveryRun {
  runId                String  @id @map("run_id")
  targetCategories     String  @map("target_categories")
  targetCategoryCode   String? @map("target_category_code")
  targetSubcategories  String? @map("target_subcategories")
  queryDescription     String? @map("query_description")
  startedAt            String  @map("started_at")
  completedAt          String? @map("completed_at")
  status               String
  candidatesDiscovered Int     @default(0) @map("candidates_discovered")
  newCompanies         Int     @default(0) @map("new_companies")
  strongDuplicates     Int     @default(0) @map("strong_duplicates")
  possibleDuplicates   Int     @default(0) @map("possible_duplicates")
  identityConflicts    Int     @default(0) @map("identity_conflicts")
  rejectedInvalid      Int     @default(0) @map("rejected_invalid")
  sourceNotes          String? @map("source_notes")

  results PipelineDiscoveryRunResult[]

  @@map("pipeline_discovery_runs")
}

model PipelineDiscoveryRunResult {
  resultId       String  @id @map("result_id")
  runId          String  @map("run_id")
  candidateIndex Int     @map("candidate_index")
  eventId        String? @map("event_id")
  companyId      String? @map("company_id")
  categories     String?
  outcome        String
  error          String?
  createdAt      String  @map("created_at")

  run PipelineDiscoveryRun @relation(fields: [runId], references: [runId], onDelete: Restrict)

  @@unique([runId, candidateIndex], map: "pipeline_discovery_run_results_run_candidate_key")
  @@index([runId, candidateIndex], map: "pipeline_idx_discovery_run_results_run")
  @@map("pipeline_discovery_run_results")
}

model Company {
  id            String              @id @default(uuid()) @db.Uuid
  displayName   String              @map("display_name")
  legalName     String?             @map("legal_name")
  slug          String              @unique
  countryCode   String?             @map("country_code")
  website       String?
  category      String?
  status        CatalogRecordStatus @default(ACTIVE)
  internalNotes String?             @map("internal_notes")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  brands                Brand[]
  products              Product[]
  pipelineLinks         CompanyPipelineLink[]
  clientVisibilityRules ClientCatalogVisibilityRule[]
  extractionReviews     ProductExtractionReview[]
  extractionSources     ProductExtractionSource[]

  @@map("catalog_companies")
}

model Brand {
  id        String              @id @default(uuid()) @db.Uuid
  /// Legacy association retained for imported C-005 records. New brands may be
  /// independent of a supplier Company and are selected from Product instead.
  companyId String?             @map("company_id") @db.Uuid
  name      String
  slug      String
  status    CatalogRecordStatus @default(ACTIVE)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  company         Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productFamilies ProductFamily[]
  products        Product[]

  @@unique([companyId, slug])
  @@index([companyId, status])
  @@map("catalog_brands")
}

model ProductFamily {
  id          String              @id @default(uuid()) @db.Uuid
  brandId     String              @map("brand_id") @db.Uuid
  name        String
  slug        String
  description String?
  status      CatalogRecordStatus @default(ACTIVE)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([brandId, slug])
  @@index([brandId, status])
  @@map("catalog_product_families")
}

model Product {
  id                String                   @id @default(uuid()) @db.Uuid
  publicReference   String                   @unique @default(cuid()) @map("public_reference")
  /// Retained only for deterministic migration history; new products do not use
  /// ProductFamily as an identity or workflow boundary.
  productFamilyId   String?                  @map("product_family_id") @db.Uuid
  companyId         String                   @map("company_id") @db.Uuid
  brandId           String?                  @map("brand_id") @db.Uuid
  taxonomyNodeId    String?                  @map("taxonomy_node_id") @db.Uuid
  name              String
  slug              String
  shortDescription  String?                  @map("short_description")
  description       String?
  internalNotes     String?                  @map("internal_notes")
  countryOfOrigin   String                   @default("DZ") @map("country_of_origin")
  publicationStatus CatalogPublicationStatus @default(DRAFT) @map("publication_status")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  productFamily         ProductFamily?                @relation(fields: [productFamilyId], references: [id], onDelete: Restrict)
  company               Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  brand                 Brand?                        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  taxonomyNode          CatalogTaxonomyNode?          @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)
  variants              Variant[]
  clientVisibilityRules ClientCatalogVisibilityRule[]
  clientFavorites       ClientCatalogFavorite[]
  extractionReviews     ProductExtractionReview[]
  extractionSources     ProductExtractionSource[]

  @@index([companyId, publicationStatus])
  @@index([brandId])
  @@index([taxonomyNodeId])
  @@map("catalog_products")
}

model Variant {
  id                  String                   @id @default(uuid()) @db.Uuid
  productId           String                   @map("product_id") @db.Uuid
  sku                 String                   @unique
  name                String?
  model               String?
  attributes          Json?
  supplierSku         String?                  @map("supplier_sku")
  mainImageUrl        String?                  @map("main_image_url")
  additionalImageUrls Json?                    @map("additional_image_urls")
  packaging           Json?
  pricingMethod       VariantPricingMethod?    @map("pricing_method")
  factoryPrice        Decimal?                 @map("factory_price") @db.Decimal(14, 2)
  markupPercent       Decimal?                 @map("markup_percent") @db.Decimal(8, 2)
  sellingPrice        Decimal?                 @map("selling_price") @db.Decimal(14, 2)
  currency            String                   @default("DZD")
  isDefault           Boolean                  @default(false) @map("is_default")
  status              CatalogRecordStatus      @default(ACTIVE)
  publicationStatus   CatalogPublicationStatus @default(DRAFT) @map("publication_status")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceHistory     VariantPriceHistory[]
  profileOverrides VariantPriceOverride[]

  @@index([productId, status, publicationStatus])
  @@map("catalog_variants")
}

model ProductExtractionReview {
  id                    String                             @id @default(uuid()) @db.Uuid
  companyId             String                             @map("company_id") @db.Uuid
  productId             String?                            @map("product_id") @db.Uuid
  state                 ProductExtractionReviewState       @default(UNDER_REVIEW)
  verificationState     ProductExtractionVerificationState @default(UNVERIFIED) @map("verification_state")
  extractedAt           DateTime                           @map("extracted_at")
  currentRevisionHash   String                             @map("current_revision_hash")
  acceptedRevisionHash  String?                            @map("accepted_revision_hash")
  acceptedAt            DateTime?                          @map("accepted_at")
  acceptedById          String?                            @map("accepted_by_id") @db.Uuid
  publishedAt           DateTime?                          @map("published_at")
  publishedById         String?                            @map("published_by_id") @db.Uuid
  currentCorrectionNote String?                            @map("current_correction_note")
  createdAt             DateTime                           @default(now()) @map("created_at")
  updatedAt             DateTime                           @updatedAt @map("updated_at")

  company      Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product      Product?                       @relation(fields: [productId], references: [id], onDelete: Restrict)
  acceptedBy   InternalUser?                  @relation("ProductExtractionAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  publishedBy  InternalUser?                  @relation("ProductExtractionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  sources      ProductExtractionSource[]
  evidence     ProductExtractionEvidence[]
  assets       ProductExtractionAsset[]
  reviewEvents ProductExtractionReviewEvent[]

  @@index([companyId, state, updatedAt])
  @@index([productId, state])
  @@map("product_extraction_reviews")
}

model ProductExtractionSource {
  id          String                      @id @default(uuid()) @db.Uuid
  reviewId    String                      @map("review_id") @db.Uuid
  companyId   String                      @map("company_id") @db.Uuid
  productId   String?                     @map("product_id") @db.Uuid
  kind        ProductExtractionSourceKind
  url         String
  title       String?
  retrievedAt DateTime                    @map("retrieved_at")
  checksum    String?
  createdAt   DateTime                    @default(now()) @map("created_at")

  review   ProductExtractionReview     @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  company  Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product  Product?                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  evidence ProductExtractionEvidence[]
  assets   ProductExtractionAsset[]

  @@index([companyId, kind])
  @@index([reviewId, kind])
  @@map("product_extraction_sources")
}

model ProductExtractionEvidence {
  id             String                              @id @default(uuid()) @db.Uuid
  reviewId       String                              @map("review_id") @db.Uuid
  sourceId       String?                             @map("source_id") @db.Uuid
  fieldPath      String                              @map("field_path")
  extractedValue Json                                @map("extracted_value")
  confidence     ProductExtractionEvidenceConfidence
  note           String?
  createdAt      DateTime                            @default(now()) @map("created_at")

  review ProductExtractionReview  @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  source ProductExtractionSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([reviewId, fieldPath])
  @@index([sourceId])
  @@map("product_extraction_evidence")
}

model ProductExtractionAsset {
  id              String                        @id @default(uuid()) @db.Uuid
  reviewId        String                        @map("review_id") @db.Uuid
  sourceId        String?                       @map("source_id") @db.Uuid
  kind            ProductExtractionAssetKind
  originalUrl     String                        @map("original_url")
  storedReference String?                       @map("stored_reference")
  checksum        String?
  mimeType        String?                       @map("mime_type")
  rightsStatus    ProductExtractionRightsStatus @default(UNKNOWN) @map("rights_status")
  createdAt       DateTime                      @default(now()) @map("created_at")

  review ProductExtractionReview  @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  source ProductExtractionSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([reviewId, kind])
  @@index([checksum])
  @@map("product_extraction_assets")
}

model ProductExtractionReviewEvent {
  id             String                        @id @default(uuid()) @db.Uuid
  reviewId       String                        @map("review_id") @db.Uuid
  fromState      ProductExtractionReviewState? @map("from_state")
  toState        ProductExtractionReviewState  @map("to_state")
  action         String
  revisionHash   String?                       @map("revision_hash")
  decisionNote   String?                       @map("decision_note")
  correctionNote String?                       @map("correction_note")
  actorId        String?                       @map("actor_id") @db.Uuid
  createdAt      DateTime                      @default(now()) @map("created_at")

  review ProductExtractionReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  actor  InternalUser?           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reviewId, createdAt])
  @@index([actorId, createdAt])
  @@map("product_extraction_review_events")
}

/// Versioned taxonomy structure. GS1 GPC and Wossol extensions are kept
/// distinguishable so a future full GPC importer can be idempotent.
model CatalogTaxonomyNode {
  id            String                @id @default(uuid()) @db.Uuid
  source        CatalogTaxonomySource
  sourceCode    String                @map("source_code")
  sourceVersion String                @map("source_version")
  level         CatalogTaxonomyLevel
  parentId      String?               @map("parent_id") @db.Uuid
  status        CatalogRecordStatus   @default(ACTIVE)
  deprecatedAt  DateTime?             @map("deprecated_at")
  replacementId String?               @map("replacement_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  parent                CatalogTaxonomyNode?          @relation("TaxonomyParent", fields: [parentId], references: [id], onDelete: Restrict)
  children              CatalogTaxonomyNode[]         @relation("TaxonomyParent")
  replacement           CatalogTaxonomyNode?          @relation("TaxonomyReplacement", fields: [replacementId], references: [id], onDelete: Restrict)
  replacedNodes         CatalogTaxonomyNode[]         @relation("TaxonomyReplacement")
  release               CatalogTaxonomyRelease        @relation(fields: [source, sourceVersion], references: [source, sourceVersion], onDelete: Restrict)
  translations          CatalogTaxonomyTranslation[]
  products              Product[]
  clientVisibilityRules ClientCatalogVisibilityRule[]

  @@unique([source, sourceCode, sourceVersion])
  @@index([parentId])
  @@map("catalog_taxonomy_nodes")
}

/// Localized labels belong to a logical taxonomy node; the source records
/// whether the translation is official GS1 content or Wossol-managed content.
model CatalogTaxonomyTranslation {
  id           String                           @id @default(uuid()) @db.Uuid
  nodeId       String                           @map("node_id") @db.Uuid
  languageCode String                           @map("language_code") @db.VarChar(5)
  source       CatalogTaxonomyTranslationSource
  name         String
  description  String?
  createdAt    DateTime                         @default(now()) @map("created_at")
  updatedAt    DateTime                         @updatedAt @map("updated_at")

  node CatalogTaxonomyNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@unique([nodeId, languageCode])
  @@index([languageCode, name])
  @@map("catalog_taxonomy_translations")
}

/// Import/install history for an immutable source release. Products continue
/// referencing the exact versioned node they were classified with.
model CatalogTaxonomyRelease {
  id            String                       @id @default(uuid()) @db.Uuid
  source        CatalogTaxonomySource
  sourceVersion String                       @map("source_version")
  status        CatalogTaxonomyReleaseStatus @default(IMPORTING)
  isActive      Boolean                      @default(false) @map("is_active")
  segmentCount  Int                          @default(0) @map("segment_count")
  familyCount   Int                          @default(0) @map("family_count")
  classCount    Int                          @default(0) @map("class_count")
  brickCount    Int                          @default(0) @map("brick_count")
  importedAt    DateTime?                    @map("imported_at")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")
  nodes         CatalogTaxonomyNode[]

  @@unique([source, sourceVersion])
  @@index([source, isActive])
  @@map("catalog_taxonomy_releases")
}

/// Append-only commercial audit trail. Product/client DTOs never expose these
/// internal commercial values.
model VariantPriceHistory {
  id              String                @id @default(uuid()) @db.Uuid
  variantId       String                @map("variant_id") @db.Uuid
  pricingMethod   VariantPricingMethod? @map("pricing_method")
  factoryPrice    Decimal?              @map("factory_price") @db.Decimal(14, 2)
  markupPercent   Decimal?              @map("markup_percent") @db.Decimal(8, 2)
  sellingPrice    Decimal?              @map("selling_price") @db.Decimal(14, 2)
  currency        String                @default("DZD")
  changedByUserId String?               @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")

  variant   Variant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  changedBy InternalUser? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@map("catalog_variant_price_history")
}

/// Internal commercial rule set applied to a Client Account's base Variant
/// selling prices. Client-facing DTOs must never return these rule values.
model PriceProfile {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  status            PriceProfileStatus @default(ACTIVE)
  defaultAdjustment Decimal            @default(0) @map("default_adjustment") @db.Decimal(8, 4)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  clientAccounts ClientAccount[]
  overrides      VariantPriceOverride[]

  @@index([status, name])
  @@map("export_price_profiles")
}

/// Sparse exceptions only: there is no row for a Variant/Profile pair unless
/// an explicit override has been configured.
model VariantPriceOverride {
  id                   String                   @id @default(uuid()) @db.Uuid
  variantId            String                   @map("variant_id") @db.Uuid
  priceProfileId       String                   @map("price_profile_id") @db.Uuid
  mode                 VariantPriceOverrideMode
  fixedClientPrice     Decimal?                 @map("fixed_client_price") @db.Decimal(14, 2)
  percentageAdjustment Decimal?                 @map("percentage_adjustment") @db.Decimal(8, 4)
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  variant      Variant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  priceProfile PriceProfile @relation(fields: [priceProfileId], references: [id], onDelete: Restrict)

  @@unique([variantId, priceProfileId])
  @@index([priceProfileId, updatedAt])
  @@map("export_variant_price_overrides")
}

/// A small, idempotent linkage seam from the separate Wossol Export supplier
/// discovery/outreach Pipeline to the canonical Company owned by this catalog.
/// Pipeline records and evidence remain in their source system.
model CompanyPipelineLink {
  id              String                       @id @default(uuid()) @db.Uuid
  sourceSystem    String                       @map("source_system")
  sourceRecordId  String                       @map("source_record_id")
  companyId       String?                      @map("company_id") @db.Uuid
  linkageStatus   PipelineCompanyLinkageStatus @default(PROPOSED) @map("linkage_status")
  sourceUpdatedAt DateTime?                    @map("source_updated_at")
  reviewedAt      DateTime?                    @map("reviewed_at")
  reviewedByRef   String?                      @map("reviewed_by_ref")
  reviewNote      String?                      @map("review_note")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([sourceSystem, sourceRecordId])
  @@index([companyId])
  @@index([linkageStatus, updatedAt])
  @@map("catalog_company_pipeline_links")
}

model InternalUser {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique
  displayName  String              @map("display_name")
  passwordHash String              @map("password_hash")
  role         InternalCatalogRole @default(CATALOG_EDITOR)
  status       InternalUserStatus  @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  sessions                   AuthSession[]
  auditEvents                AuthAuditEvent[]
  priceHistory               VariantPriceHistory[]
  extractionReviewsAccepted  ProductExtractionReview[]      @relation("ProductExtractionAcceptedBy")
  extractionReviewsPublished ProductExtractionReview[]      @relation("ProductExtractionPublishedBy")
  extractionReviewEvents     ProductExtractionReviewEvent[]

  @@map("export_internal_users")
}

model ClientAccount {
  id                  String                    @id @default(uuid()) @db.Uuid
  name                String
  accountType         ClientAccountType         @default(DIRECT_CLIENT) @map("account_type")
  status              ClientAccountStatus       @default(ACTIVE)
  priceProfileId      String?                   @map("price_profile_id") @db.Uuid
  pricesVisible       Boolean                   @default(false) @map("prices_visible")
  catalogAccessStatus ClientCatalogAccessStatus @default(DISABLED) @map("catalog_access_status")
  catalogAccessMode   ClientCatalogAccessMode   @default(SELECTED) @map("catalog_access_mode")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  users           ClientUser[]
  sessions        AuthSession[]
  auditEvents     AuthAuditEvent[]
  priceProfile    PriceProfile?                 @relation(fields: [priceProfileId], references: [id], onDelete: Restrict)
  visibilityRules ClientCatalogVisibilityRule[]
  favorites       ClientCatalogFavorite[]
  partner         PartnerAccount?

  @@index([priceProfileId, status])
  @@map("export_client_accounts")
}

/// Partner tenant identity is separate from the Wossol-managed account
/// settings record, which remains the source for Price Profile and Catalog
/// Access configuration.
model PartnerAccount {
  id               String   @id @default(uuid()) @db.Uuid
  catalogAccountId String   @unique @map("catalog_account_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  catalogAccount ClientAccount    @relation(fields: [catalogAccountId], references: [id], onDelete: Restrict)
  users          PartnerUser[]
  sessions       AuthSession[]
  auditEvents    AuthAuditEvent[]

  @@map("export_partner_accounts")
}

model PartnerUser {
  id               String           @id @default(uuid()) @db.Uuid
  partnerAccountId String           @map("partner_account_id") @db.Uuid
  email            String           @unique
  displayName      String           @map("display_name")
  passwordHash     String           @map("password_hash")
  status           ClientUserStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  partnerAccount PartnerAccount   @relation(fields: [partnerAccountId], references: [id], onDelete: Restrict)
  sessions       AuthSession[]
  auditEvents    AuthAuditEvent[]

  @@index([partnerAccountId, status])
  @@map("export_partner_users")
}

/// Selected visibility remains sparse and references canonical catalog
/// records. ALL_APPROVED is represented by ClientAccount.catalogAccessMode,
/// not by one grant row per Product.
model ClientCatalogVisibilityRule {
  id              String                        @id @default(uuid()) @db.Uuid
  clientAccountId String                        @map("client_account_id") @db.Uuid
  effect          ClientCatalogVisibilityEffect @default(INCLUDE)
  targetType      ClientCatalogVisibilityTarget @map("target_type")
  taxonomyNodeId  String?                       @map("taxonomy_node_id") @db.Uuid
  companyId       String?                       @map("company_id") @db.Uuid
  productId       String?                       @map("product_id") @db.Uuid
  createdAt       DateTime                      @default(now()) @map("created_at")

  clientAccount ClientAccount        @relation(fields: [clientAccountId], references: [id], onDelete: Restrict)
  taxonomyNode  CatalogTaxonomyNode? @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)
  company       Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product       Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([clientAccountId, effect, taxonomyNodeId], map: "export_client_visibility_rule_client_effect_taxonomy_key")
  @@unique([clientAccountId, effect, companyId], map: "export_client_visibility_rule_client_effect_company_key")
  @@unique([clientAccountId, effect, productId], map: "export_client_visibility_rule_client_effect_product_key")
  @@index([clientAccountId, effect, targetType], map: "export_client_visibility_rule_client_effect_target_idx")
  @@index([taxonomyNodeId, effect], map: "export_client_visibility_rule_taxonomy_effect_idx")
  @@index([companyId])
  @@index([productId])
  @@map("export_client_catalog_visibility_rules")
}

model ClientUser {
  id              String                @id @default(uuid()) @db.Uuid
  clientAccountId String                @map("client_account_id") @db.Uuid
  email           String                @unique
  displayName     String                @map("display_name")
  passwordHash    String                @map("password_hash")
  designation     ClientUserDesignation @default(CLIENT_USER)
  status          ClientUserStatus      @default(ACTIVE)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  clientAccount ClientAccount    @relation(fields: [clientAccountId], references: [id], onDelete: Restrict)
  sessions      AuthSession[]
  auditEvents   AuthAuditEvent[]

  @@map("export_client_users")
}

model ClientCatalogFavorite {
  clientAccountId String   @map("client_account_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([clientAccountId, productId])
  @@index([productId])
  @@map("export_client_catalog_favorites")
}

model AuthSession {
  id               String        @id @default(uuid()) @db.Uuid
  tokenHash        String        @unique @map("token_hash")
  actorType        AuthActorType @map("actor_type")
  internalUserId   String?       @map("internal_user_id") @db.Uuid
  clientUserId     String?       @map("client_user_id") @db.Uuid
  clientAccountId  String?       @map("client_account_id") @db.Uuid
  partnerUserId    String?       @map("partner_user_id") @db.Uuid
  partnerAccountId String?       @map("partner_account_id") @db.Uuid
  expiresAt        DateTime      @map("expires_at")
  revokedAt        DateTime?     @map("revoked_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  lastSeenAt       DateTime      @default(now()) @map("last_seen_at")

  internalUser   InternalUser?   @relation(fields: [internalUserId], references: [id], onDelete: Restrict)
  clientUser     ClientUser?     @relation(fields: [clientUserId], references: [id], onDelete: Restrict)
  clientAccount  ClientAccount?  @relation(fields: [clientAccountId], references: [id], onDelete: Restrict)
  partnerUser    PartnerUser?    @relation(fields: [partnerUserId], references: [id], onDelete: Restrict)
  partnerAccount PartnerAccount? @relation(fields: [partnerAccountId], references: [id], onDelete: Restrict)

  @@index([internalUserId, revokedAt, expiresAt])
  @@index([clientUserId, revokedAt, expiresAt])
  @@index([partnerAccountId, revokedAt, expiresAt])
  @@index([partnerUserId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("export_auth_sessions")
}

model AuthAuditEvent {
  id               String         @id @default(uuid()) @db.Uuid
  action           String
  actorType        AuthActorType? @map("actor_type")
  internalUserId   String?        @map("internal_user_id") @db.Uuid
  clientUserId     String?        @map("client_user_id") @db.Uuid
  clientAccountId  String?        @map("client_account_id") @db.Uuid
  partnerUserId    String?        @map("partner_user_id") @db.Uuid
  partnerAccountId String?        @map("partner_account_id") @db.Uuid
  entityType       String?        @map("entity_type")
  entityId         String?        @map("entity_id")
  ipAddress        String?        @map("ip_address")
  metadata         Json?
  createdAt        DateTime       @default(now()) @map("created_at")

  internalUser   InternalUser?   @relation(fields: [internalUserId], references: [id], onDelete: SetNull)
  clientUser     ClientUser?     @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  clientAccount  ClientAccount?  @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  partnerUser    PartnerUser?    @relation(fields: [partnerUserId], references: [id], onDelete: SetNull)
  partnerAccount PartnerAccount? @relation(fields: [partnerAccountId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([internalUserId, createdAt])
  @@index([clientUserId, createdAt])
  @@index([partnerAccountId, createdAt])
  @@index([partnerUserId, createdAt])
  @@map("export_auth_audit_events")
}

model AuthRateLimit {
  id           String    @id @default(uuid()) @db.Uuid
  key          String    @unique
  failures     Int       @default(0)
  windowStart  DateTime  @map("window_start")
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([blockedUntil])
  @@map("export_auth_rate_limits")
}
